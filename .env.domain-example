# ============================================
# DOMAIN AND IP CONFIGURATION EXAMPLES
# ============================================

# Copy the appropriate section to your .env file

# ============================================
# Example 1: LOCALHOST + PORT
# ============================================
# APP_URL=http://localhost:8000
# SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=false

# ============================================
# Example 2: IP ADDRESS
# ============================================
# APP_URL=http://192.168.1.100:8000
# SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=false

# ============================================
# Example 3: DOMAIN (HTTP)
# ============================================
# APP_URL=http://svrms.local
# SESSION_DOMAIN=svrms.local
# SESSION_SECURE_COOKIE=false
# SESSION_SAME_SITE=lax

# ============================================
# Example 4: DOMAIN (HTTPS - PRODUCTION)
# ============================================
# APP_URL=https://svrms.yourdomain.com
# SESSION_DOMAIN=.yourdomain.com
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# SESSION_HTTP_ONLY=true

# ============================================
# Example 5: MULTIPLE SUBDOMAINS
# ============================================
# APP_URL=https://app.svrms.com
# SESSION_DOMAIN=.svrms.com
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

# ============================================
# HOST FILE ENTRIES (C:\Windows\System32\drivers\etc\hosts)
# ============================================
# 127.0.0.1       svrms.local
# 127.0.0.1       app.svrms.local
# 192.168.1.100   svrms.local
